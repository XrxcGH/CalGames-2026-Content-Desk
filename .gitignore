node_modules/
dist/

# Event logs, one NDJSON per session. Keep the ones worth replaying.
data/events/*.ndjson
!data/events/sample.ndjson

# Runtime state: queued uploads, local file paths, video ids.
data/publish-queue.json
data/publish-queue.json.tmp

# The trivia question bank. Edits from the host console save back here
# mid-show, and a fresh clone gets the same built-in set from questions.ts.
data/trivia.json
data/trivia.json.tmp

# The on-camera profile book. Real people's names, filled in at the event and
# specific to it; a fresh clone starts empty and fills itself again.
data/profiles.json
data/profiles.json.tmp

# Team media library. Robot cutouts are large and event-specific. The manifest
# lives in memory, rebuilt from each team's meta.json on boot.
media/teams/*/

# House audio: walk-up songs and stingers. Somebody else's recordings, loaded
# per event, and the one category of file in this repo that must never be
# redistributed with it.
media/audio/

# Rolling record scratch. 4 cams x 1080p60 is ~22GB/hour, so never commit it.
rec/

# Credentials. config.example.json is the committed template.
config.json
*.log

# The launcher build caches the Node runtime it embeds. 34MB, and reproducible
# from the pinned version and checksum in tools/launcher/build.ps1.
tools/launcher/.cache/

# Rotated Spotify refresh token. A bearer credential for the music account,
# written by the desk when Spotify hands back a new one.
data/spotify-token.json
data/spotify-token.json.tmp

# Rendered previews of every screen. Regenerated by `npm run previews`;
# committed on purpose, because the whole point is showing somebody the
# graphics without setting a desk up first.
!previews/
