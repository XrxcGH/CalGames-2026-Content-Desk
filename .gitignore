node_modules/
dist/

# Event logs, one NDJSON per session. Every one of them, with no named
# exception: a log is the verbatim record of a day, and the payloads are
# people. panel.show carries full names and roles, lower_third.show carries
# the name that went on air, trivia.updated carries every crowd player's
# chosen name and team, award.presented carries the winner, and card.call
# carries a team number next to a free-text penalty reason.
#
# There used to be a "!data/events/sample.ndjson" line here, un-ignoring one
# log by exact filename against a replay command the docs had spelled out.
# No such file was ever committed, so the line only ever sat waiting for the
# obvious move: copy a real session to that name to make the documented
# command work, and ship the whole event with it. If a committed sample is
# ever wanted, generate a synthetic one from `npm start -- --demo` and put it
# somewhere that is meant to be committed; never re-open this door.
data/events/*.ndjson

# Runtime state: queued uploads, local file paths, video ids.
data/publish-queue.json
data/publish-queue.json.tmp

# The trivia question bank. Edits from the host console save back here
# mid-show, and a fresh clone gets the same built-in set from questions.ts.
data/trivia.json
data/trivia.json.tmp

# The Judge Advisor's staged award winners: the one file on disk that holds a
# secret the whole architecture exists to keep. Deleted entry by entry as the
# ceremony presents them.
data/awards-staged.json
data/awards-staged.json.tmp

# Slides typed at the event and the pending shout-out queue: event-specific,
# and the queue is unmoderated crowd text that must never be committed.
data/slides.json
data/slides.json.tmp

# Event content edited at the desk: awards, sponsors, run of show, and the
# rest of the content half of config.json. Event-specific by definition.
data/event-content.json
data/event-content.json.tmp

# The on-camera profile book. Real people's names, filled in at the event and
# specific to it; a fresh clone starts empty and fills itself again.
data/profiles.json
data/profiles.json.tmp

# Caption sidecars a volunteer captioner drops in by hand, picked up by the
# publish queue (publish/captions.ts). A caption file is a word-for-word
# transcript of what was said on air: names, teams, whatever was read out.
# As event-specific as everything else named here, and it was the one
# desk-read directory under data/ with no rule at all.
#
# Named one by one, like its neighbours, because the tidier-looking
# "data/* plus negations" cannot work: git will not re-include a file whose
# parent directory is excluded. The cost of naming is that a NEW file under
# data/ is committable until somebody adds it here. Add it here.
data/captions/

# Team media library. Robot cutouts are large and event-specific. The manifest
# lives in memory, rebuilt from each team's meta.json on boot.
media/teams/*/

# House audio: walk-up songs and stingers. Somebody else's recordings, loaded
# per event, and the one category of file in this repo that must never be
# redistributed with it.
media/audio/

# Rolling record scratch. 4 cams x 1080p60 is ~22GB/hour, so never commit it.
rec/

# Credentials. config.example.json is the committed template.
config.json
*.log

# The launcher build caches the Node runtime it embeds. 34MB, and reproducible
# from the pinned version and checksum in tools/launcher/build.ps1.
tools/launcher/.cache/

# Rotated Spotify refresh token. A bearer credential for the music account,
# written by the desk when Spotify hands back a new one.
data/spotify-token.json
data/spotify-token.json.tmp

# Rendered previews of every screen. Regenerated by `npm run previews`;
# committed on purpose, because the whole point is showing somebody the
# graphics without setting a desk up first.
!previews/

# Built from RUN-THE-DESK.md by `npm run handbook`. The PDF IS committed
# (volunteers need it without running anything), but the HTML fallback and the
# temp file are not.
RUN-THE-DESK.html
.handbook.tmp.html
