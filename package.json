{
  "name": "cg2026-content-desk",
  "version": "0.1.0",
  "description": "In-house analysis and broadcast content desk for CalGames 2026.",
  "license": "Apache-2.0",
  "author": "Western Region Robotics Forum (WRRF) and contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/XrxcGH/cg2026-content-desk.git"
  },
  "homepage": "https://github.com/XrxcGH/cg2026-content-desk#readme",
  "bugs": {
    "url": "https://github.com/XrxcGH/cg2026-content-desk/issues"
  },
  "keywords": [
    "frc",
    "first-robotics",
    "broadcast",
    "overlay",
    "obs",
    "cheesy-arena",
    "scoreboard",
    "esports"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --watch apps/core/src/index.ts",
    "start": "node --experimental-strip-types apps/core/src/index.ts",
    "replay": "node --experimental-strip-types apps/core/src/index.ts --replay",
    "fake-arena": "node --experimental-strip-types apps/core/src/ingest/cheesy/fake-arena.ts",
    "validate:offline": "node harness-offline.mjs",
    "auth:youtube": "node --experimental-strip-types apps/core/src/publish/youtube-auth.ts",
    "test": "node --experimental-strip-types --test \"apps/core/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "auth:spotify": "node --experimental-strip-types apps/core/src/audio/spotify-auth.ts",
    "previews": "node tools/render-previews.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.8.0"
  }
}
